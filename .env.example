# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- PostgreSQL (application database) ----
# postgresql | sqlite (sqlite only for quick local experiments)
DB_ENGINE=postgresql
DB_NAME=echovance
DB_USER=echovance
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
# Optional: superuser password, used ONLY by scripts/setup_db.py to create DB_USER/DB_NAME once.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=

# ---- AI provider: OpenAI ----
# New AI analysis and action suggestions use OpenAI (default model gpt-4o-mini). Put your key below.
# Nothing is ever sent beyond the request budget the owner authorises (manage.py llm_budget): a fresh
# database allows 3 real requests; raising it is explicit and capped by LLM_LIFETIME_REQUEST_CEILING.
# Without a key the app still runs: imported data and stored results stay available; new AI requests are refused.
# Offline demo instead (no key, no cost): ECHOVANCE_AI_MODE=demo and LLM_PROVIDER=mock - a deterministic keyword
# test double whose results are labelled MOCK and kept in a separate "demo" data scope (not AI analysis).
ECHOVANCE_AI_MODE=real
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
# Never retry by default; quota/rate-limit/auth errors are never retried in any case.
LLM_MAX_RETRIES=0
LLM_MAX_INPUT_CHARS=1000
LLM_MAX_OUTPUT_TOKENS=1024
# Real-request budget: initial authorised total (persisted in the DB; changed only via llm_budget --authorize).
LLM_INITIAL_AUTHORIZED_REQUESTS=3
# Real messages per UI/API "Analyse" click (bulk work goes through manager-authorised jobs).
LLM_REAL_MAX_PER_REQUEST=1

# ---- Budget and cost limits (persisted ledger) ----
# Lifetime ceiling for `manage.py llm_budget --authorize N --confirm`
LLM_LIFETIME_REQUEST_CEILING=20
# Prices of OPENAI_MODEL in USD per 1M tokens (gpt-4o-mini: $0.15 input / $0.60 output). They must match the
# model; leaving them empty makes every real request refuse ("pricing unknown") instead of guessing.
OPENAI_PRICE_INPUT_PER_MTOK=0.15
OPENAI_PRICE_OUTPUT_PER_MTOK=0.60
# Month-to-date spend ceiling. One gpt-4o-mini analysis costs at most ~$0.0011, so 20 requests stay under $0.03.
# 0 would block every request.
LLM_MONTHLY_COST_CEILING_USD=1.00
LLM_MAX_INPUT_TOKENS_PER_REQUEST=4000
LLM_RATE_LIMIT_RPM=10
# Privacy gate: data classifications that may be sent to OpenAI ('confidential' is never sent)
LLM_PAID_ALLOWED_DATA_CLASSES=public,internal

# ---- Upload limits ----
CSV_MAX_UPLOAD_BYTES=5242880
CSV_MAX_ROWS=20000
