# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- PostgreSQL (application database) ----
# postgresql | sqlite (sqlite only for quick local experiments)
DB_ENGINE=postgresql
DB_NAME=echovance
DB_USER=echovance
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
# Optional: superuser password, used ONLY by scripts/setup_db.py to create DB_USER/DB_NAME once.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=

# ---- LLM provider ----
# Default below = DEMO: a deterministic keyword mock (no API key, no network, no cost). Every mock result
# is labelled MOCK and kept in the separate "demo" data scope; it is NOT real AI analysis.
# Real Gemini (see README, "Real Gemini integration"): ECHOVANCE_AI_MODE=real, LLM_PROVIDER=gemini and a
# valid GEMINI_API_KEY; nothing is sent until the owner authorises a request budget (manage.py llm_budget).
# openai is DISABLED (shared training quota) until explicitly authorised via LLM_OPENAI_ENABLED=true.
ECHOVANCE_AI_MODE=demo
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_OPENAI_ENABLED=false
LLM_TIMEOUT_SECONDS=30
# Never retry by default; quota/rate-limit errors are never retried in any case.
LLM_MAX_RETRIES=0
LLM_MAX_INPUT_CHARS=1000
LLM_MAX_OUTPUT_TOKENS=1024
# Real-request budget: initial authorised total (persisted in the DB; changed only via llm_budget --authorize).
LLM_INITIAL_AUTHORIZED_REQUESTS=3
LLM_REAL_MAX_PER_REQUEST=1

# ---- Budget v2 (persisted ledger; nothing is sent beyond the owner-authorised total) ----
# Lifetime ceiling for `manage.py llm_budget --authorize N --confirm`
LLM_LIFETIME_REQUEST_CEILING=20
# free = $0 (Gemini free tier). For a paid tier set GEMINI_TIER=paid AND both prices (USD per 1M tokens).
GEMINI_TIER=free
GEMINI_PRICE_INPUT_PER_MTOK=
GEMINI_PRICE_OUTPUT_PER_MTOK=
LLM_MONTHLY_COST_CEILING_USD=0
LLM_MAX_INPUT_TOKENS_PER_REQUEST=4000
LLM_RATE_LIMIT_RPM=10
# Privacy gate for paid tiers (the free tier only ever receives 'public' data)
LLM_PAID_ALLOWED_DATA_CLASSES=public,internal
# Hybrid grouping similarity: tfidf (local, free) | gemini_embedding (budgeted API)
GROUPING_SIMILARITY=tfidf

# ---- Upload limits ----
CSV_MAX_UPLOAD_BYTES=5242880
CSV_MAX_ROWS=20000
