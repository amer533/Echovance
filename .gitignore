# --- secrets & local config ---
.env
.env.*
!.env.example
.demo_credentials.txt

# --- datasets ---
# The raw Kaggle dump and the unredacted local subset/splits/profiles stay local (CC BY-NC-SA 4.0, personal
# data). Committed: the privacy-reviewed public subset (generated by scripts/export_public_dataset.py) and
# the invented demo fixture.
data/*
!data/spotifycares_public/
!data/sample/

# --- local reports and generated benchmark/evaluation output (not part of the code submission) ---
docs/

